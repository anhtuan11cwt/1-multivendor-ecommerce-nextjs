# Cloudinary credentials — lấy từ https://console.cloudinary.com (Dashboard -> Account Settings -> Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB Atlas — tạo cluster miễn phí M0, thêm user + whitelist IP, lấy connection string từ mục Drivers
# Dạng mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Lưu ý: thêm tên database (vd lime-ecom-db) vào cuối URL vì Atlas không tự điền
DATABASE_URL=""

# URL gốc của ứng dụng (dùng cho fetch từ client)
NEXT_PUBLIC_BASE_URL=http://localhost:3000